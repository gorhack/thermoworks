{
  "pluginAlias": "ThermoworksPlugin",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "required": ["name","apiKey"],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "ThermoWorks Plugin"
      },
      "apiKey": {
        "title": "API Key",
        "type": "string",
        "pattern": "^[A-Za-z0-9-_]*$",
        "description": "Found at https://cloud.thermoworks.com/account Integrations"
      },
      "delay": {
        "title": "Delay (in seconds)",
        "type": "number",
        "placeholder": "5",
        "pattern": "^[0-9]*$",
        "description": "Add an additional delay if your Homekit readings are behind your ThermoWorks readings."
      }
    }
  }
}